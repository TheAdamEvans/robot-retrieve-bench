# Allow-list: everything at the top level is ignored unless opted in below. Public-safe by default.
/*
!/.gitignore
!/.python-version
!/README.md
!/SCAND_index.csv
!/SCAND_data_headers.csv
!/pyproject.toml
!/uv.lock
!/tools_codegen.sh
!/build_dashboard.py
!/server/
!/index/
!/train/
!/benchmark/
!/annotations/
!/annotations_recheck/
!/docs/
!/presentation/

# Never data, envs, or generated outputs
/annotations/renders/
/annotations/tmp/
/annotations_recheck/renders/
*.pdf
**/__pycache__/
*.pyc
.DS_Store
*.mcap
*.bag
*.avi
*.safetensors
*.parquet
.env
